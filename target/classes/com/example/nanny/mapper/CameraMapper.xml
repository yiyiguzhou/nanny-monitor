<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.nanny.mapper.CameraMapper">

    <resultMap id="BaseResultMap" type="com.example.nanny.domain.Camera">
            <id property="id" column="id" />
            <result property="name" column="name" />
            <result property="rtspUrl" column="rtsp_url" />
            <result property="active" column="active" />
    </resultMap>

    <sql id="Base_Column_List">
        id,name,rtsp_url,active
    </sql>

    <select id="findTop10By" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM camera
        LIMIT 10
    </select>
</mapper>